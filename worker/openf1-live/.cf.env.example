# Cloudflare credentials for scripts/deploy-live-worker.sh. Copy to .cf.env (git-ignored) and fill in.
# Token: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token -> "Edit Cloudflare Workers"
# Account ID: dash.cloudflare.com -> Workers & Pages -> Overview -> right-hand sidebar
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
