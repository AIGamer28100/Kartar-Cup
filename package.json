{
  "name": "kartar-cup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy": "firebase deploy --project kartar-cup --only hosting,firestore:rules",
    "deploy:all": "firebase deploy --project kartar-cup",
    "worker:dev": "cd worker/places-proxy && wrangler dev --env dev --port 8787",
    "worker:secret": "cd worker/places-proxy && wrangler secret put GOOGLE_PLACES_API_KEY",
    "worker:deploy": "cd worker/places-proxy && wrangler deploy",
    "check:openf1": "node scripts/check-openf1-ids.mjs",
    "worker:smoke": "node scripts/smoke-places-proxy.mjs",
    "worker:live:dev": "cd worker/openf1-live && wrangler dev --env dev --port 8788",
    "worker:live:secret": "cd worker/openf1-live && wrangler secret put OPENF1_USERNAME && wrangler secret put OPENF1_PASSWORD",
    "worker:live:deploy": "cd worker/openf1-live && wrangler deploy",
    "worker:live:smoke": "node scripts/smoke-live-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "firebase": "12.19.0",
    "framer-motion": "13.4.4",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.31.0",
    "globals": "^17.13.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.149.0"
  }
}
