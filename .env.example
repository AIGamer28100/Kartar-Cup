# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=kartar-cup

# Venue search: URL of the Cloudflare Worker in worker/places-proxy (the Google key lives only there)
VITE_PLACES_PROXY_URL=

# Paid OpenF1 live lap count: URL of the Worker in worker/openf1-live. Leave EMPTY (free tier, host types the
# lap) until the owner has OpenF1 credentials and has deployed that Worker. See worker/openf1-live/README.md
VITE_OPENF1_LIVE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kartar-cup.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=kartar-cup.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ship the dev Mock Lab (/race-state-mock) in a PRODUCTION build until this moment, then it stops
# resolving. Leave EMPTY for normal releases: unset means the whole src/dev subtree is dropped from
# the bundle. Client-clock based, so it is a convenience, not a security control.
VITE_MOCK_LAB_UNTIL=
