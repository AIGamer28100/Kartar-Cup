rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/hosts/$(request.auth.token.email.lower()));
    }
    function evDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data; }
    function activeId() { return get(/databases/$(database)/documents/settings/active).data.eventId; }
    // Server clock (request.time); R13 window plus manual override. Override 'open' can never pass closesAt.
    function acceptingEntries(eventId) {
      let ev = evDoc(eventId);
      return activeId() == eventId
        && ev.override != 'closed'
        && request.time < ev.closesAt
        && (ev.override == 'open' || request.time >= ev.opensAt);
    }
    function validWhatsapp(u) {
      return u is string && (u == ''
        || u.matches('^https://chat\\.whatsapp\\.com/[A-Za-z0-9_-]{1,64}$')
        || u.matches('^https://whatsapp\\.com/channel/[A-Za-z0-9_-]{1,64}$'));
    }
    // NOTE: per-item label caps for drivers/questions are inlined (1000-expression budget); teams are client-capped.
    function promptsOk(l, i) {
      return l.size() <= i || (l[i].prompt.size() <= 80 && l[i].get('hint', '').size() <= 160);
    }
    function validEvent(eventId) {
      let d = request.resource.data;
      let dr = d.drivers;
      let qs = d.questions;
      return d.keys().hasOnly(['id','raceId','name','subtitle','circuit','themeId','raceStartUtc','raceDurationMin',
                'opensAt','closesAt','override','whatsappUrl','teams','drivers','questions','questionIds',
                'winnerRevealed','tiebreakOverride','nextQuestionSeq','createdAt','updatedAt'])
        && d.keys().hasAll(['id','raceId','name','subtitle','circuit','themeId','raceStartUtc','raceDurationMin',
                'opensAt','closesAt','override','whatsappUrl','teams','drivers','questions','questionIds',
                'winnerRevealed','tiebreakOverride','createdAt','updatedAt'])
        && d.id == eventId
        && d.raceId is string && d.raceId.size() <= 60
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.subtitle is string && d.subtitle.size() <= 120
        && (d.circuit == null || (d.circuit is string && d.circuit.size() <= 80))
        && d.themeId is string && d.themeId.size() <= 60
        && d.raceStartUtc is timestamp
        && d.raceDurationMin is number && d.raceDurationMin >= 10 && d.raceDurationMin <= 600
        && d.opensAt is timestamp && d.closesAt is timestamp && d.closesAt > d.opensAt
        && d.override in ['none','open','closed']
        && validWhatsapp(d.whatsappUrl)
        && d.teams is list && d.teams.size() <= 12
        && d.drivers is list && d.drivers.size() <= 24
        && d.questions is list && d.questions.size() <= 8
        && d.questionIds is list && d.questionIds.size() <= 8
        && d.questionIds.size() == d.questions.size()
        && (!('nextQuestionSeq' in d) || (d.nextQuestionSeq is int && d.nextQuestionSeq >= 1 && d.nextQuestionSeq <= 1000))
        && (dr.size() <= 0 || dr[0].label.size() <= 80) && (dr.size() <= 1 || dr[1].label.size() <= 80) && (dr.size() <= 2 || dr[2].label.size() <= 80) && (dr.size() <= 3 || dr[3].label.size() <= 80)
        && (dr.size() <= 4 || dr[4].label.size() <= 80) && (dr.size() <= 5 || dr[5].label.size() <= 80) && (dr.size() <= 6 || dr[6].label.size() <= 80) && (dr.size() <= 7 || dr[7].label.size() <= 80)
        && (dr.size() <= 8 || dr[8].label.size() <= 80) && (dr.size() <= 9 || dr[9].label.size() <= 80) && (dr.size() <= 10 || dr[10].label.size() <= 80) && (dr.size() <= 11 || dr[11].label.size() <= 80)
        && (dr.size() <= 12 || dr[12].label.size() <= 80) && (dr.size() <= 13 || dr[13].label.size() <= 80) && (dr.size() <= 14 || dr[14].label.size() <= 80) && (dr.size() <= 15 || dr[15].label.size() <= 80)
        && (dr.size() <= 16 || dr[16].label.size() <= 80) && (dr.size() <= 17 || dr[17].label.size() <= 80) && (dr.size() <= 18 || dr[18].label.size() <= 80) && (dr.size() <= 19 || dr[19].label.size() <= 80)
        && (dr.size() <= 20 || dr[20].label.size() <= 80) && (dr.size() <= 21 || dr[21].label.size() <= 80) && (dr.size() <= 22 || dr[22].label.size() <= 80) && (dr.size() <= 23 || dr[23].label.size() <= 80)
        && promptsOk(qs, 0) && promptsOk(qs, 1) && promptsOk(qs, 2) && promptsOk(qs, 3)
        && promptsOk(qs, 4) && promptsOk(qs, 5) && promptsOk(qs, 6) && promptsOk(qs, 7)
        && d.winnerRevealed is bool
        && (d.tiebreakOverride == null || (d.tiebreakOverride is string && d.tiebreakOverride.size() <= 128));
    }
    function answerOk(a, q, i) {
      return q.size() <= i || (a[q[i]] is string && a[q[i]].size() <= 40);
    }
    function validEntry(eventId, uid) {
      let d = request.resource.data;
      let q = evDoc(eventId).questionIds;
      return d.keys().hasOnly(['uid','name','email','phone','provider','answers','submittedAt','createdAt'])
        && d.keys().hasAll(['uid','name','email','provider','answers','submittedAt','createdAt'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && (!('phone' in d) || (d.phone is string && d.phone.matches('^[+0-9 ]{7,16}$')))
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && d.email is string && d.email.lower() == request.auth.token.email.lower()
        && d.provider == 'google'
        && d.answers is map
        && d.answers.keys().toSet().hasOnly(q.toSet())
        && d.answers.keys().toSet().hasAll(q)
        && answerOk(d.answers, q, 0) && answerOk(d.answers, q, 1) && answerOk(d.answers, q, 2)
        && answerOk(d.answers, q, 3) && answerOk(d.answers, q, 4) && answerOk(d.answers, q, 5)
        && answerOk(d.answers, q, 6) && answerOk(d.answers, q, 7)
        && d.submittedAt == request.time;
    }

    match /settings/active {
      allow read: if true;
      allow write: if isHost() && request.resource.data.keys().hasOnly(['eventId'])
                   && request.resource.data.eventId is string
                   && request.resource.data.eventId.size() >= 1 && request.resource.data.eventId.size() <= 60;
    }
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isHost() && validEvent(eventId);
      allow delete: if isHost();

      match /results/answers {
        allow read: if isHost() || evDoc(eventId).winnerRevealed == true;
        allow write: if isHost();
      }
      match /entries/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || isHost();
        allow list, delete: if isHost();
        allow create: if signedIn() && request.auth.uid == uid && acceptingEntries(eventId)
                      && validEntry(eventId, uid) && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && request.auth.uid == uid && acceptingEntries(eventId)
                      && validEntry(eventId, uid) && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
    match /hosts/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
